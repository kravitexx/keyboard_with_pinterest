<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pinterest_auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/setup_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/action_bar_color"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/pinterest_auth_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pinterest_close"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/pinterest_auth_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:paddingHorizontal="8dp"
            android:singleLine="true"
            android:text="@string/pinterest_auth_title"
            android:textColor="@color/foreground"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pinterest_auth_pick_account"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:text="@string/pinterest_pick_google_account"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pinterest_auth_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#33FF9800"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/pinterest_auth_banner_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/foreground"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pinterest_auth_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:max="100"
        android:visibility="gone" />

    <WebView
        android:id="@+id/pinterest_auth_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
